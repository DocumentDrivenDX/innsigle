{
  "name": "innsigle",
  "version": "0.3.0",
  "description": "The maker's seal for published work \u2014 content provenance CLI (claim, sign, verify).",
  "type": "module",
  "bin": {
    "innsigle": "./src/cli.mjs"
  },
  "files": [
    "src/**",
    "README.md",
    "docs/sample/**",
    "tests/vectors/**",
    "integrations/**",
    "skills/**"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DocumentDrivenDX/innsigle.git"
  },
  "homepage": "https://documentdrivendx.github.io/innsigle/",
  "bugs": {
    "url": "https://github.com/DocumentDrivenDX/innsigle/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "innsigle": "node src/cli.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:update": "CI=true playwright test --update-snapshots",
    "test:agent": "bash scripts/agent-check.sh",
    "test:agent:update": "bash scripts/agent-check.sh --update-snapshots",
    "test:hugo": "node --test tests/hugo-workflow.test.mjs",
    "test:provenance-driver": "node scripts/agent-provenance-driver.mjs",
    "test:provenance-driver:live": "INNSIGLE_LIVE_AGENTS=1 node scripts/agent-provenance-driver.mjs --live",
    "demo:hugo": "bash scripts/demo-hugo-innsigle.sh",
    "record:hugo-walkthrough": "bash scripts/record-hugo-walkthrough.sh",
    "vectors": "node scripts/generate-vectors.mjs",
    "site:publish": "node scripts/publish-artifacts.mjs",
    "site:build": "node scripts/build-site.mjs",
    "site:build:local": "SITE_BASE= node scripts/build-site.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "serve": "^14.2.6"
  },
  "license": "MIT"
}
