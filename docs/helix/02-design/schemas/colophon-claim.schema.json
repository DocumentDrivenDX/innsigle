{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://innsigle.dev/schema/colophon-claim/v1.json",
  "title": "Innsigle colophon claim payload v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["innsigle", "type", "issued_at", "issuer", "subjects", "colophon"],
  "properties": {
    "innsigle": { "const": "1" },
    "type": { "const": "https://innsigle.dev/claim/colophon/v1" },
    "issued_at": { "type": "string", "minLength": 1 },
    "issuer": {
      "type": "object",
      "required": ["id", "name", "key_id", "key_url"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "key_id": { "type": "string", "pattern": "^ed25519:[0-9a-f]{32}$" },
        "key_url": {
          "type": "string",
          "minLength": 8,
          "description": "Absolute issuer document URL (ADR-003); covered by claim signature"
        }
      }
    },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["digest"],
        "properties": {
          "uri": { "type": "string" },
          "digest": {
            "type": "object",
            "required": ["alg", "value"],
            "properties": {
              "alg": { "const": "sha256" },
              "value": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          }
        }
      }
    },
    "colophon": {
      "type": "object",
      "required": ["schema_version", "composition", "ingredients"],
      "properties": {
        "schema_version": { "const": "1" },
        "composition": {
          "enum": ["human-authored", "mixed", "model-primary"]
        },
        "ingredients": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "name"],
            "properties": {
              "kind": { "enum": ["model", "tool", "human", "other"] },
              "name": { "type": "string", "minLength": 1 },
              "role": { "type": "string" },
              "version": { "type": ["string", "null"] },
              "uri": { "type": "string" }
            }
          }
        },
        "notes": { "type": ["string", "null"] },
        "human_input": {
          "type": "object",
      "required": ["method", "basis", "percent", "weights", "direction", "contribution", "review"],
      "properties": {
        "method": { "const": "hi1" },
        "basis": { "const": "session-journal" },
        "percent": { "type": "integer", "minimum": 0, "maximum": 100 },
        "weights": {
          "type": "object",
          "required": ["direction", "contribution", "review"],
          "properties": {
            "direction": { "type": "integer", "minimum": 0 },
            "contribution": { "type": "integer", "minimum": 0 },
            "review": { "type": "integer", "minimum": 0 }
          }
        },
        "direction": {
          "type": ["object", "null"],
          "required": ["percent", "user_prompts", "model_write_bursts"],
          "properties": {
            "percent": { "type": "integer", "minimum": 0, "maximum": 100 },
            "user_prompts": { "type": "integer", "minimum": 0 },
            "model_write_bursts": { "type": "integer", "minimum": 0 }
          }
        },
        "contribution": {
          "type": "object",
          "required": ["percent", "human_chars", "model_chars", "human_write_events", "coverage"],
          "properties": {
            "percent": { "type": "integer", "minimum": 0, "maximum": 100 },
            "human_chars": { "type": "integer", "minimum": 0 },
            "model_chars": { "type": "integer", "minimum": 0 },
            "human_write_events": { "type": "integer", "minimum": 0 },
            "coverage": { "enum": ["full", "partial"] }
          }
        },
        "review": {
          "type": ["object", "null"],
          "required": ["percent", "post_output_prompts", "review_events"],
          "properties": {
            "percent": { "type": "integer", "minimum": 0, "maximum": 100 },
            "post_output_prompts": { "type": "integer", "minimum": 0 },
            "review_events": { "type": "integer", "minimum": 0 }
          }
        }
      }
        },
        "provenance": {
          "type": "object",
          "required": ["kind", "digest"],
          "properties": {
            "kind": { "const": "session" },
            "digest": {
              "type": "object",
              "required": ["alg", "value"],
              "properties": {
                "alg": { "const": "sha256" },
                "value": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
              }
            },
            "uri": { "type": ["string", "null"] }
          }
        }
      }
    }
  }
}
